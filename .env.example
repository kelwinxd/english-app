# ==== API (apps/api) ====
NODE_ENV=development
PORT=3333
# Postgres do Railway (deixe vazio localmente até ter o banco de pé)
DATABASE_URL=
# Origem do front, para o CORS
WEB_ORIGIN=http://localhost:5173

# ==== Worker (apps/worker) — Fase 5 ====
REDIS_URL=

# ==== APIs externas (chaves NUNCA vão pro front) — Fases 5/6 ====
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
# Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
# Mercado Pago (Fase 6)
MERCADOPAGO_ACCESS_TOKEN=

# ==== WEB (apps/web) — prefixo VITE_, NUNCA segredos aqui ====
# Em dev fica vazio (usa o proxy do Vite). Em produção aponte para a URL da API no Railway.
VITE_API_URL=
